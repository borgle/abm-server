# ABM_S3_PREFIX=abm
# ABM_S3_ADDRESSING_STYLE=path
# ABM_S3_USE_SSL=false
# ABM_S3_AUTO_CREATE_BUCKET=true
ABM_RENDER_NO_SANDBOX=true
ABM_RESEARCH_PARALLEL_SEARCHES=2
ABM_RESEARCH_PAUSE_ON_INTERSTITIAL=true
ABM_RESEARCH_ATTENTION_TIMEOUT_SECONDS=300
