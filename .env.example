ABM_HOST=0.0.0.0
ABM_EDITION=single
ABM_LOCAL_GENERATIONS_PER_DAY=0
ABM_LOCAL_TOKENS_PER_MONTH=0
ABM_LOCAL_IMAGES_PER_DAY=0
ABM_LOCAL_IMAGE_MAX_N=4
ABM_LOCAL_STORAGE_BYTES=0
ABM_LOCAL_RESEARCH_PAGES_PER_MONTH=0
ABM_LOCAL_BROWSER_CONNECTIONS=5
ABM_LOCAL_BROWSER_SESSIONS=3
ABM_LOCAL_RESERVED_PRIORITY_SLOTS=1
# single = self-hosted, one account; hosted = multi-user (private cloud build)
ABM_PORT=18050
ABM_DATABASE_URL=sqlite+aiosqlite:///./data/abm.db
ABM_PUBLIC_BASE_URL=
ABM_OAUTH_ISSUER_URL=
ABM_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
ABM_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
ABM_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
ABM_OAUTH_PENDING_TTL_SECONDS=600
ABM_FORWARDED_ALLOW_IPS=127.0.0.1
ABM_EXTENSION_ID=cojffalolochaigkgngieopcefcgbcag
ABM_EXTENSION_GITHUB_URL=https://github.com/borgle/abm-extension
ABM_EXTENSION_RELEASE_URL=https://github.com/borgle/abm-extension/releases/latest
ABM_EXTENSION_STORE_URL=
ABM_SESSION_COOKIE_SECURE=true
# Days to keep expired/revoked sign-in sessions (they store the client IP).
ABM_SESSION_RETENTION_DAYS=90
ABM_EMAIL_MODE=log
ABM_SMTP_HOST=
ABM_SMTP_PORT=587
ABM_SMTP_USERNAME=
ABM_SMTP_PASSWORD=
ABM_SMTP_FROM=no-reply@localhost
ABM_SMTP_STARTTLS=true
ABM_EMAIL_VERIFICATION_TTL_SECONDS=86400
ABM_PASSWORD_RESET_TTL_SECONDS=3600
ABM_REGISTRATION_REQUIRE_APPROVAL=true
ABM_SOCIAL_LOGIN_ENABLED=true
ABM_SOCIAL_LOGIN_STATE_TTL_SECONDS=600
ABM_SOCIAL_GOOGLE_CLIENT_ID=
ABM_SOCIAL_GOOGLE_CLIENT_SECRET=
ABM_SOCIAL_GITHUB_CLIENT_ID=
ABM_SOCIAL_GITHUB_CLIENT_SECRET=
ABM_SOCIAL_MICROSOFT_CLIENT_ID=
ABM_SOCIAL_MICROSOFT_CLIENT_SECRET=
ABM_SOCIAL_MICROSOFT_TENANT=common
ABM_SOCIAL_WECHAT_CLIENT_ID=
ABM_SOCIAL_WECHAT_CLIENT_SECRET=
ABM_SOCIAL_QQ_CLIENT_ID=
ABM_SOCIAL_QQ_CLIENT_SECRET=
ABM_BOOTSTRAP_ADMIN_EMAIL=
ABM_BOOTSTRAP_ADMIN_PASSWORD=
ABM_MAX_ACTIVE_KEYS_FREE=2
ABM_MAX_ACTIVE_KEYS_PRO=10
ABM_QUOTA_TOOL_CALLS_FREE=1000
ABM_QUOTA_TOOL_CALLS_PRO=20000
ABM_QUOTA_VIDEO_BYTES_FREE=524288000
ABM_QUOTA_VIDEO_BYTES_PRO=10737418240
ABM_QUOTA_VIDEO_JOBS_FREE=10
ABM_QUOTA_VIDEO_JOBS_PRO=200
ABM_QUOTA_ENFORCEMENT=hard
ABM_ALERT_WEBHOOK_URL=
ABM_TOOL_TIMEOUT_MS=300000
ABM_MCP_SESSION_LEASE_TTL_SECONDS=1800
ABM_EXTENSION_MAX_CONNECTIONS_PER_KEY=5
ABM_EXTENSION_MAX_SESSIONS_PER_CONNECTION=3
ABM_EXTENSION_RESERVED_PRIORITY_SLOTS=1
ABM_RESEARCH_PARALLEL_SEARCHES=2
ABM_RESEARCH_PAUSE_ON_INTERSTITIAL=true
ABM_RESEARCH_ATTENTION_TIMEOUT_SECONDS=300
ABM_VIDEO_CHUNK_BYTES=20971520
ABM_VIDEO_JOB_TTL_MS=1800000
