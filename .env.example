ABM_VIDEO_TEMP_DIR=
ABM_VIDEO_BRIDGE_TOKEN_TTL_SECONDS=3600
ABM_MAX_VIDEO_BYTES=2147483648
ABM_VIDEO_DELIVERY=auto
ABM_HEARTBEAT_MS=30000
ABM_STALE_TIMEOUT_MS=90000
ABM_HELLO_TIMEOUT_MS=10000
ABM_LOG_LEVEL=info


# Creation module: base64-encoded 32-byte key used to encrypt provider API keys.
ABM_CREATION_SECRET_KEY=

# Creation media storage. Use s3 for MinIO/S3/R2; local keeps files on disk.
ABM_STORAGE_BACKEND=local
ABM_MEDIA_ROOT=data/media
ABM_MEDIA_MAX_BYTES=10485760
ABM_EXPORT_RETENTION_DAYS=7
